<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.1</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>
  <groupId>com.simple</groupId>
  <artifactId>chiralium</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>chiralium</name>
  <description>chiralium</description>
  <properties>
    <java.version>21</java.version>
  </properties>
  <packaging>pom</packaging>
  <modules>
    <module>chiralium-common</module>
    <module>chiralium-handler</module>
    <module>chiralium-support</module>
    <module>chiralium-service-api</module>
    <module>chiralium-service-api-impl</module>
    <module>chiralium-web</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.simple</groupId>
        <artifactId>chiralium-common</artifactId>
        <version>0.0.1-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.simple</groupId>
        <artifactId>chiralium-support</artifactId>
        <version>0.0.1-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.simple</groupId>
        <artifactId>chiralium-handler</artifactId>
        <version>0.0.1-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.simple</groupId>
        <artifactId>chiralium-service-api</artifactId>
        <version>0.0.1-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.simple</groupId>
        <artifactId>chiralium-service-api-impl</artifactId>
        <version>0.0.1-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.simple</groupId>
        <artifactId>chiralium-web</artifactId>
        <version>0.0.1-SNAPSHOT</version>
      </dependency>
      <!--uni-sms短信平台sdk-->
      <dependency>
        <groupId>com.apistd.uni</groupId>
        <artifactId>uni-sdk</artifactId>
        <version>0.0.4</version>
      </dependency>
      <!--mysql连接工具-->
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>8.4.0</version>
      </dependency>
      <!--mybatis plus-->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>3.5.7</version>
      </dependency>
      <!--mybatis plus多表查询工具-->
      <dependency>
        <groupId>com.github.yulichang</groupId>
        <artifactId>mybatis-plus-join-boot-starter</artifactId>
        <version>1.4.13</version>
      </dependency>
      <!--hutool工具包-->
      <dependency>
        <groupId>cn.hutool</groupId>
        <artifactId>hutool-all</artifactId>
        <version>5.8.26</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
